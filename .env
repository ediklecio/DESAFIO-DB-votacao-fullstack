# Copy this file to .env and adjust as needed. Never commit the real .env.
#
# DB_HOST must stay "db" (the docker-compose service name below) when running
# via `docker compose up` - the app container reaches Postgres through the
# dedicated compose network, not through localhost.
DB_HOST=db
DB_PORT=5432
DB_NAME=vote
DB_USER=vote
DB_PASSWORD=bg002_
